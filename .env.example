# ===== WSA - Web Security Auditing =====
# Copy this file to .env and adjust values.

FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# SQLite database file (relative to project root)
DATABASE_URL=sqlite:///wsa.db

# External security tools (leave empty if not installed -> shows "Not configured")
ZAP_API_URL=
ZAP_API_KEY=
NUCLEI_BIN=
GOSQLI_BIN=

# Optional AI provider: openai | anthropic | custom
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
