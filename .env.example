# ===== WSA - Web Security Auditing =====
# Copy this file to .env and adjust values.

FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# SQLite database file (relative to project root)
DATABASE_URL=sqlite:///wsa.db

# ===== Sign-in verification =====
# EMAIL_VERIFICATION_ENABLED is the master switch. false = this instance verifies
# nothing: sign-up creates a usable account straight away (no code email and no
# mail server needed) and sign-in asks only for the email address and password.
# true = shipped default: sign-up proves the address with a code, and
# LOGIN_OTP_ENABLED then decides whether each *sign-in* also needs a code.
EMAIL_VERIFICATION_ENABLED=true
LOGIN_OTP_ENABLED=true
OTP_LENGTH=6
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ===== Email (SMTP) =====
# Without MAIL_SERVER no code can be delivered, and sign-up and sign-in both
# refuse with an actionable message instead of pretending to have sent one.
# Gmail example: smtp.gmail.com / 587 / your address / a 16-character app password.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=
MAIL_SENDER_NAME=WSA - Web Security Auditing

# Development only: write each message to instance/mail/<timestamp>.eml instead
# of contacting SMTP. Never enable in production (codes land on disk in clear).
# A configured MAIL_SERVER always wins over this, so filling in SMTP above is
# enough to start sending real email.
MAIL_FILE_DELIVERY=false
MAIL_FILE_DIR=

# External security tools (leave empty if not installed -> shows "Not configured")
ZAP_API_URL=
ZAP_API_KEY=
# Optional MCP endpoint for the ZAP-MCP card. Leave empty to use native ZAP API mode.
ZAP_MCP_URL=
# Start the bundled ZAP daemon (tools/start-zap.bat) automatically when ZAP is
# not yet reachable. Set to false to manage the daemon yourself.
ZAP_AUTOSTART=true
ZAP_AUTOSTART_TIMEOUT=180
NUCLEI_BIN=
GOSQLI_BIN=

# AI provider (Settings > AI / LLM overrides these): openai | anthropic | custom
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
